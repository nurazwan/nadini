# ---- LLM (OpenAI or any OpenAI-compatible endpoint) -------------------------
OPENAI_API_KEY=sk-...
# Any chat model your endpoint serves.
LLM_MODEL=gpt-5-mini
# Point at Ollama / vLLM / a LiteLLM proxy / Azure OpenAI ...
# OPENAI_BASE_URL=http://localhost:11434/v1
# Omit for models that only accept the default temperature.
# LLM_TEMPERATURE=0.2

# ---- Server ----------------------------------------------------------------
PORT={{ port }}
# URL clients use to reach this agent (advertised in the A2A agent card).
PUBLIC_URL=http://localhost:{{ port }}
# Dev chat UI at /dev-ui. NEVER enable in production.
DEV_UI_ENABLED=true
# Bearer token required on A2A / MCP / dev API when set.
{%- if enable_auth %}
AUTH_TOKEN=change-me
{%- else %}
# AUTH_TOKEN=change-me
{%- endif %}
# MCP DNS-rebinding protection: allowed Host headers (JSON list). Empty = off.
# MCP_ALLOWED_HOSTS=["localhost:*","agent.example.com"]
{%- if checkpointer == 'postgres' %}
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
{%- endif %}

# ---- OpenTelemetry (-> Grafana Alloy / LGTM) --------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME={{ project_slug }}
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# Turn all telemetry off:
# OTEL_SDK_DISABLED=true
# Keep prompts / completions out of traces (PII):
# OPENINFERENCE_HIDE_INPUTS=true
# OPENINFERENCE_HIDE_OUTPUTS=true
{%- if enable_langfuse %}

# ---- Langfuse (cloud or self-hosted) ----------------------------------------
# Leave the keys empty to disable Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
{%- endif %}
