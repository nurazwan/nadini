"""Agent configuration, read from environment variables (and `.env`)."""

from functools import lru_cache

from pydantic import SecretStr
from pydantic_settings import BaseSettings, SettingsConfigDict


class AgentSettings(BaseSettings):
    model_config = SettingsConfigDict(env_file=".env", extra="ignore")

    agent_name: str = {{ project_name | tojson }}

    # LLM (any OpenAI-compatible endpoint works via OPENAI_BASE_URL)
    llm_model: str = ""
    llm_temperature: float | None = None
    openai_api_key: SecretStr | None = None
    openai_base_url: str | None = None
{%- if checkpointer == 'postgres' %}

    # Conversation memory
    database_url: str = "postgresql://agent:agent@localhost:5432/agent"
{%- endif %}


@lru_cache
def get_settings() -> AgentSettings:
    return AgentSettings()
