.PHONY: deps upgrade dev run test lint fmt build up down

deps:          ## resolve latest versions of all dependencies into uv.lock
	uv run --no-project scripts/deps.py

upgrade:       ## bump every locked dependency to its latest version
	uv lock --upgrade && uv sync

dev:           ## run locally with auto-reload and the dev UI
	DEV_UI_ENABLED=true uv run uvicorn server.app:app --reload --host {{ bind_host }} --port {{ port }}

run:           ## run locally like production
	uv run uvicorn server.app:app --host {{ bind_host }} --port {{ port }}

test:
	uv run pytest -q

lint:
	uv run ruff check . && uv run ruff format --check .

fmt:
	uv run ruff check --fix . && uv run ruff format .

build:         ## build the Docker image
	docker build -t {{ project_slug }}:latest .

up:            ## agent + Grafana LGTM{% if checkpointer == 'postgres' %} + Postgres{% endif %}
	docker compose up --build

down:
	docker compose down
