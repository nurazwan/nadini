#!/usr/bin/env sh
# Resolve the LATEST version of every dependency and lock it in uv.lock.
# Package names only - versions are never hardcoded in this template.
# Re-run any time (`make deps`); use `make upgrade` to bump an existing lock.
set -eu

RUNTIME="
langchain
langchain-openai
{%- if framework == 'langgraph' %}
langgraph
{%- endif %}
{%- if checkpointer == 'postgres' %}
langgraph-checkpoint-postgres
psycopg[binary,pool]
{%- endif %}
a2a-sdk[http-server]
mcp
starlette
uvicorn[standard]
sse-starlette
pydantic-settings
opentelemetry-sdk
opentelemetry-exporter-otlp-proto-http
opentelemetry-instrumentation-asgi
opentelemetry-instrumentation-logging
openinference-instrumentation-langchain
{%- if enable_langfuse %}
langfuse
{%- endif %}
"

DEV="
pytest
pytest-asyncio
httpx
ruff
"

# shellcheck disable=SC2086
uv add --no-sync $RUNTIME
# shellcheck disable=SC2086
uv add --no-sync --dev $DEV
uv sync
