name: ci
on:
  push:
    branches: [main]
{%- if ci == 'dockerhub' %}
    tags: ["v*"]
{%- endif %}
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v10.3.0
      - run: uv sync --locked
      - run: uv run ruff check .
      - run: uv run pytest -q

  docker:
    runs-on: ubuntu-latest
    needs: test
{%- if ci == 'dockerhub' %}
    permissions:
      contents: read
    # Pushes on main (latest, sha-xxxxxxx) and v* tags (1.2.3, 1.2). PRs only build.
    steps:
      - uses: actions/checkout@v7
      - uses: docker/login-action@v4
{%- if docker_builder == 'runner' %}
        if: github.event_name != 'pull_request'
{%- endif %}
        with:
          username: {% raw %}${{ secrets.DOCKERHUB_USERNAME }}{% endraw %}
          password: {% raw %}${{ secrets.DOCKERHUB_TOKEN }}{% endraw %}
{%- if docker_builder == 'cloud' %}
      # Docker Build Cloud: native amd64 + arm64 builders with a shared cache.
      - uses: docker/setup-buildx-action@v4
        with:
          driver: cloud
          endpoint: {{ build_cloud_builder }}
{%- else %}
      - uses: docker/setup-qemu-action@v4
      - uses: docker/setup-buildx-action@v4
{%- endif %}
      - id: meta
        uses: docker/metadata-action@v6
        with:
          images: {{ dockerhub_image }}
          tags: |
{%- raw %}
            type=raw,value=latest,enable={{is_default_branch}}
            type=sha
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
{%- endraw %}
      - uses: docker/build-push-action@v7
        with:
          context: .
          platforms: linux/amd64,linux/arm64
{%- raw %}
          push: ${{ github.event_name != 'pull_request' }}
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
{%- endraw %}
{%- if docker_builder == 'runner' %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
{%- endif %}
{%- else %}
    steps:
      - uses: actions/checkout@v7
      - uses: docker/setup-buildx-action@v4
      - uses: docker/build-push-action@v7
        with:
          context: .
          push: false
          tags: {% raw %}${{ github.repository }}:${{ github.sha }}{% endraw %}
{%- endif %}
